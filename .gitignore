```gitignore
# Entorno virtual
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/
.coverage
htmlcov/

# IDE / Visual Studio Code
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# Logs
*.log

# Builds y paquetes
build/
dist/
*.egg-info/

# Variables de entorno
.env
.env.*

# Archivos temporales
*.tmp
*.temp
```
